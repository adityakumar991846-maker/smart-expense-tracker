# Django Security Settings
SECRET_KEY=django-insecure-smart-expense-tracker-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL)
# Set DB_ENGINE to 'django.db.backends.mysql' for MySQL, or 'django.db.backends.sqlite3' for local SQLite
DB_ENGINE=django.db.backends.mysql
DB_NAME=smart_expense_tracker
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# OCR Configuration
# If Tesseract is in your system PATH, leave as 'tesseract'.
# On Windows, set full path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
